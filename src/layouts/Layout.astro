---
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingControls from "../components/layout/FloatingControls.astro";
import CartWrapper from "../components/cart/CartWrapper";
import ThemeListener from "../components/theme/ThemeListener";
import GA4Script from "../components/analytics/GA4Script.astro";
import "../styles/global.css";
import { SERVICE_PROVIDER, CLIENT_CONFIG } from "../config";
import { getThemeColorFromCSS } from "../utils/theme";
import { loadTheme, generateCSSVariables } from "../utils/loadTheme";
import { getImageUrl } from "../lib/imageUrl";
import { getFontDefinition, type FontConfig } from "../lib/fontUtils";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  menuData: any;
}

const {
  title = "Menú",
  description,
  keywords,
  menuData,
} = Astro.props;

const ga4Id = menuData?.config?.ga4Id;

// Get values from Sanity with fallbacks to CLIENT_CONFIG
const siteUrl = menuData?.config?.siteUrl || CLIENT_CONFIG.defaultSiteUrl;
const siteName = menuData?.brand?.name || CLIENT_CONFIG.defaultSiteName;
const enableOrdering = menuData?.config?.enableOrdering !== false; // Default to true

// SEO Configuration
const author = SERVICE_PROVIDER.name;
const ogImage = `${siteUrl.replace(/\/$/, "")}/web-app-manifest-512x512.png`;

// Hybrid Theme System
const useLocalCSS = import.meta.env.USE_LOCAL_CSS === "true";
let themeColor = "#060606"; // default fallback
let dynamicThemeStyles = "";

if (!useLocalCSS) {
  // Load theme from Sanity
  try {
    const theme = await loadTheme();
    dynamicThemeStyles = generateCSSVariables(theme);

    // Add product background image if available
    if (menuData?.theme?.productBackgroundImage) {
      dynamicThemeStyles += `\n  --product-bg-image: url('${menuData.theme.productBackgroundImage}');`;
    }

    themeColor =
      theme.themeNavbar?.bg || theme.themeApplication?.bgMain || "#060606";
  } catch (error) {
    // Fallback to local CSS on error
  }
} else {
  // Use local CSS - get theme color from CSS
  themeColor = getThemeColorFromCSS();
}

const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;

// --- Typography Logic ---
const typography = menuData?.typography;
let fontDefinitions: any[] = [];
let typographyCSS = "";

if (typography) {
  const fontFields = [
    "sectionTitle",
    "productTitle",
    "productPrice",
    "productDescription",
    "productNameModal",
  ];

  fontFields.forEach((field) => {
    const config = typography[field] as FontConfig;
    if (!config) return;

    // 1. Get Loading Definition (Link or Style)
    const def = getFontDefinition(config);
    if (def) {
      fontDefinitions.push(def);
    }

    // 2. Generate CSS Variables
    const cssPrefix = field
      .replace(/([a-z0-9])([A-Z])/g, "$1-$2")
      .toLowerCase();

    const family =
      config.customFileUrl
        ? (config.customFamily || config.family || "CustomFont")
        : (config.origin === "custom" ? config.customFamily : config.family);

    if (family) {
      typographyCSS += `--font-${cssPrefix}-family: '${family}', sans-serif;\n`;
      typographyCSS += `--font-${cssPrefix}-style: ${config.style || "normal"};\n`;
      typographyCSS += `--font-${cssPrefix}-weight: ${config.weight || "400"};\n`;

      if (config.sizeValue !== undefined && config.sizeValue !== null) {
        const unit = config.sizeUnit || "px";
        typographyCSS += `--font-${cssPrefix}-size: ${config.sizeValue}${unit};\n`;
      }

      if (config.lineHeight !== undefined && config.lineHeight !== null) {
        typographyCSS += `--font-${cssPrefix}-line-height: ${config.lineHeight}px;\n`;
      }
    }
  });

  // Simple deduplication based on content/href
  const uniqueDefs = new Map();
  fontDefinitions.forEach((def) => {
    const key = def.tag === "link" ? def.attributes.href : def.content;
    if (!uniqueDefs.has(key)) {
      uniqueDefs.set(key, def);
    }
  });
  fontDefinitions = Array.from(uniqueDefs.values());
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content={themeColor} />

    <!-- iOS PWA Meta Tags -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Preload product background image to avoid black flash when opening modals -->
    {menuData?.theme?.productBackgroundImage && (
      <link rel="preload" as="image" href={menuData.theme.productBackgroundImage} />
    )}

    <!-- Performance: DNS Prefetch & Preconnect (must be before font stylesheets) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Limelight&family=Raleway:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    {
      fontDefinitions.map((def: any) =>
        def.tag === "link" ? (
          <link
            rel="stylesheet"
            href={def.attributes.href}
          />
        ) : (
          <style is:inline set:html={def.content} />
        ),
      )
    }

    <!-- Google Fonts: Async loading to prevent render blocking -->
    <!-- Preload the font stylesheet for faster discovery -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    />
    <!-- Load fonts asynchronously using media="print" trick -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <!-- Fallback for users with JavaScript disabled -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Google Analytics 4 -->
    <GA4Script ga4Id={ga4Id} restaurantId={menuData?.config?.restaurantId} />

    {
      (dynamicThemeStyles || typographyCSS) ? (
        <style
          is:inline
          set:html={`:root {\n    ${dynamicThemeStyles || ''}\n    ${typographyCSS || ''}\n  }`}
        />
      ) : null
    }

    <style>
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    <style>
      body {
        min-height: max(884px, 100dvh);
      }
    </style>
  </head>

  <body class="font-display bg-bg-main">
    <div class="w-full min-h-screen">
      <Navbar
        sections={menuData.sections}
        brand={menuData.brand}
        enableOrdering={enableOrdering}
      />
      <slot />
      <Footer
        addresses={menuData.addresses}
        socialMedia={menuData.socialMedia}
        socialMediaSectionTitle={menuData.socialMediaSectionTitle}
        addressesSectionTitle={menuData.addressesSectionTitle}
        config={menuData.config}
        brandName={menuData.brand?.name}
      />
      <FloatingControls
        showWhatsapp={menuData.showWhatsappButton}
        phoneNumber={menuData.whatsappNumber}
        message={menuData.whatsappMessage}
      />
      {
        enableOrdering && (
          <CartWrapper
            client:load
            currency={menuData.currencySymbol || "$"}
            phone={menuData.whatsappNumber || ""}
            restaurantName={menuData.brand?.name}
            whatsappButtonText={menuData.cartWhatsappButtonText}
            whatsappFooterText={menuData.whatsappFooterText}
            bestSellerLabel={menuData.bestSellersTitleSingular}
            newLabel={menuData.newsTitleSingular}
            logoUrl={getImageUrl(
              menuData.brand?.logo || menuData.brand?.logoOverlay,
            )}
            fulfillmentConfig={{
              hasDelivery: menuData.config?.hasDelivery,
              hasPickup: menuData.config?.hasPickup,
              hasDineIn: menuData.config?.hasDineIn,
              tableCount: menuData.config?.tableCount,
            }}
            showProductNotes={menuData.config?.showProductNotes !== false}
          />
        )
      }
      {
        /* Theme Editor Listener - receives real-time color updates via BroadcastChannel */
      }
      <ThemeListener client:load />
      <script is:inline>
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            navigator.serviceWorker
              .register("/service-worker.js")
              .then((registration) => {
                console.log("SW registered: ", registration);
              })
              .catch((registrationError) => {
                console.log("SW registration failed: ", registrationError);
              });
          });
        }
      </script>
    </div>
  </body>
</html>
