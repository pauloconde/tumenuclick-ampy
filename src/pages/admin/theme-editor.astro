---
/**
 * Theme Editor Page
 *
 * Protected admin page for visual theme customization.
 * Only accessible when THEME_EDITOR_ENABLED=true in .env.local
 */
import ThemeEditorPanel from "../../components/theme/ThemeEditorPanel";

// Check if editor is enabled
const isEnabled = import.meta.env.THEME_EDITOR_ENABLED === "true";

// Return 404 if not enabled
if (!isEnabled) {
    return new Response(null, { status: 404 });
}
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Theme Editor | Admin</title>
        <meta name="robots" content="noindex, nofollow" />

        <!-- Minimal styles for the editor -->
        <style is:global>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            html,
            body {
                height: 100%;
                overflow: hidden;
                font-family:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    Oxygen, Ubuntu, sans-serif;
            }
        </style>
    </head>
    <body>
        <ThemeEditorPanel client:only="react" />
    </body>
</html>
