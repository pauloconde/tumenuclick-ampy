---

<footer class="bg-footer-bg text-footer-text">
    <div class="container mx-auto px-4 py-8">
        <div
            class="flex flex-col md:flex-row justify-between items-center gap-6"
        >
            <!-- Direcciones -->
            {
                addresses && addresses.length > 0 && (
                    <div class="flex flex-col gap-3 w-full md:w-1/2 items-end md:items-start">
                        <h4 class="text-xl font-bold text-footer-accent text-right md:text-left w-full">
                            {addressesSectionTitle}
                        </h4>
                        <div class="grid gap-5 w-full">
                            {addresses.map((addr: any) => (
                                <div class="flex flex-col gap-1 items-end md:items-start text-right md:text-left">
                                    <h4 class="font-bold text-lg">
                                        {addr.showTitle ? addr.name : ""}
                                    </h4>
                                    <p class="text-md opacity-90 max-w-[280px] sm:max-w-[350px] md:max-w-md">
                                        {addr.address}
                                    </p>
                                    {addr.schedule && (
                                        <p class="text-sm opacity-75 italic">
                                            {addr.schedule}
                                        </p>
                                    )}
                                    {addr.mapUrl && (
                                        <a
                                            href={addr.mapUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex items-center gap-3 text-sm bg-[var(--color-footer-btn-bg)] hover:bg-[var(--color-footer-btn-hover)] text-[var(--color-footer-btn-text)] px-4 py-1 mt-1 rounded-full transition-colors duration-300 w-fit"
                                            aria-label={`Ver ubicación de ${addr.name} en el mapa`}
                                            data-track-click="click_location"
                                            data-destination-url={addr.mapUrl}
                                            data-label={`Maps: ${addr.name}`}
                                        >
                                            <svg
                                                class="w-4 h-4 fill-current "
                                                viewBox="0 0 24 24"
                                            >
                                                <path d={iconMap.Maps} />
                                            </svg>
                                            <span>Cómo llegar</span>
                                        </a>
                                    )}
                                </div>
                            ))}
                        </div>
                    </div>
                )
            }

            {/* Redes Sociales */}
            {
                socialMedia && socialMedia.length > 0 && (
                    <div class="flex flex-col gap-4 w-full md:w-1/2 items-end">
                        <h4 class="text-xl font-bold text-footer-accent text-right w-full">
                            {socialMediaSectionTitle}
                        </h4>
                        <div class="flex gap-4">
                            {socialMedia.map((social: any) => {
                                // Buscar el ícono de forma case-insensitive
                                const iconPath = Object.entries(iconMap).find(
                                    ([key]) =>
                                        key.toLowerCase() ===
                                        social.name.toLowerCase(),
                                )?.[1];

                                if (!iconPath) {
                                    if (import.meta.env.DEV) {
                                        console.warn(
                                            `No icon found for social media: ${social.name}`,
                                        );
                                    }
                                    return null;
                                }

                                return (
                                    <a
                                        href={social.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="bg-[var(--color-footer-btn-bg)] p-3 rounded-full hover:bg-[var(--color-footer-btn-hover)] transition-colors duration-300 group"
                                        aria-label={`Visitar ${social.name}`}
                                        data-track-click="click_social"
                                        data-destination-url={social.url}
                                        data-label={social.name}
                                    >
                                        <svg
                                            class="w-6 h-6 fill-[var(--color-footer-btn-text)] group-hover:text-[var(--color-footer-btn-text)]"
                                            viewBox="0 0 24 24"
                                            style="fill: var(--color-footer-btn-text);"
                                        >
                                            <path d={iconPath} />
                                        </svg>
                                    </a>
                                );
                            })}

                            {/* Share Button */}
                            {siteUrl && (
                                <button
                                    id="share-button"
                                    class="bg-[var(--color-footer-btn-bg)] p-3 rounded-full hover:bg-[var(--color-footer-btn-hover)] transition-colors duration-300 group"
                                    aria-label="Compartir sitio"
                                    data-share-url={siteUrl}
                                    data-share-title={brandName}
                                >
                                    <svg
                                        class="w-6 h-6 fill-[var(--color-footer-btn-text)] group-hover:text-[var(--color-footer-btn-text)]"
                                        viewBox="0 0 24 24"
                                        style="fill: var(--color-footer-btn-text);"
                                    >
                                        <path d={iconMap.Share} />
                                    </svg>
                                </button>
                            )}
                        </div>
                        {/* PWA Install Button */}
                        <InstallButton client:idle />
                    </div>
                )
            }
        </div>
    </div>

    <!-- Subfooter -->
    <div
        class="bg-subfooter-bg brightness-80 text-subfooter-text py-4 text-sm text-center"
    >
        <div
            class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-2"
        >
            <p>
                &copy; {currentYear}
                <a
                    href={SERVICE_PROVIDER.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-footer-accent hover:underline font-bold"
                    >{SERVICE_PROVIDER.name}.</a
                >
                {SERVICE_PROVIDER.footerPrefix}
                {SERVICE_PROVIDER.developer}.
            </p>
            <p></p>
        </div>
    </div>
</footer>

<script>
    // Web Share API handler
    const shareButton = document.getElementById("share-button");

    if (shareButton) {
        shareButton.addEventListener("click", async () => {
            const shareUrl = shareButton.dataset.shareUrl;
            const shareTitle = shareButton.dataset.shareTitle;

            if (!shareUrl) {
                return;
            }

            // Check if Web Share API is supported
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: shareTitle || "Menú",
                        url: shareUrl,
                    });
                } catch (err) {
                    // User cancelled share or there was an error
                    if (err instanceof Error && err.name !== "AbortError") {
                        // Fallback to clipboard
                        copyToClipboard(shareUrl);
                    }
                }
            } else {
                // Fallback: Copy to clipboard
                copyToClipboard(shareUrl);
            }
        });
    }

    function copyToClipboard(text: string) {
        if (navigator.clipboard) {
            navigator.clipboard
                .writeText(text)
                .then(() => {
                    alert("URL copiada al portapapeles");
                })
                .catch((err) => {
                    console.error("Error copying to clipboard:", err);
                    alert("No se pudo copiar la URL");
                });
        } else {
            // Older fallback method
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.left = "-999999px";
            document.body.appendChild(textArea);
            textArea.select();
            try {
                document.execCommand("copy");
                alert("URL copiada al portapapeles");
            } catch (err) {
                console.error("Error copying to clipboard:", err);
                alert("No se pudo copiar la URL");
            }
            document.body.removeChild(textArea);
        }
    }
</script>
