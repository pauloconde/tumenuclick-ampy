---
import { SERVICE_PROVIDER } from "../../config";
import InstallButton from "../pwa/InstallButton";

interface Props {
    addresses: any[];
    socialMedia: any[];
    socialMediaSectionTitle: string;
    addressesSectionTitle: string;
    config: any;
    brandName: string;
}

const {
    addresses,
    socialMedia,
    socialMediaSectionTitle,
    addressesSectionTitle,
    config,
    brandName,
} = Astro.props;

const siteUrl = config?.siteUrl || "";
const currentYear = new Date().getFullYear();

