---
import { getImageUrl } from "../../lib/imageUrl";

interface Props {
    sections: any[];
    brand: any;
    enableOrdering?: boolean;
}

const { sections, brand, enableOrdering = true } = Astro.props;

const logoUrl = brand?.logo
    ? getImageUrl(brand.logo)
    : "/images/placeholder.svg";
---

<nav
    class="sticky top-0 z-50 bg-navbar-bg shadow-md px-3 py-2 sm:px-6 sm:py-3 flex justify-between items-center gap-2 sm:gap-4"
>
    <div class="flex items-center flex-shrink min-w-0">
        <h1 class="sr-only">{brand?.name || "Restaurante"}</h1>
        <img
            src={logoUrl}
            alt={brand?.name || "Logo"}
            class="h-12 sm:h-16 md:h-20 max-w-[48vw] sm:max-w-none w-auto object-contain transition-all duration-300"
            height="128"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            aria-hidden="true"
        />
    </div>

    <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0 justify-end min-w-0">
        {/* Quick Search Button */}
        <button
            id="navbar-search-btn"
            type="button"
            aria-label="Buscar producto"
            class="flex items-center justify-center p-2 rounded-[var(--radius-navbar-select)] bg-navbar-select-bg border border-navbar-select-border text-navbar-select-text hover:opacity-80 active:scale-95 transition-all shadow-sm"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 sm:w-5 sm:h-5 text-navbar-select-icon"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 21l-4.35-4.35m1.85-5.65a7 7 0 11-14 0 7 7 0 0114 0z"
                />
            </svg>
        </button>

        {
            sections && sections.length > 1 && (
                <div class="relative">
                    <label for="section-select" class="sr-only">
                        Navegar a sección
                    </label>
                    <select
                        id="section-select"
                        class="navbar-select appearance-none bg-navbar-select-bg border border-navbar-select-border text-navbar-select-text py-1.5 px-3 pr-7 sm:py-2 sm:px-4 sm:pr-8 text-xs sm:text-sm rounded-[var(--radius-navbar-select)] leading-tight focus:outline-none truncate max-w-[130px] sm:max-w-xs"
                    >
                        <option value="" disabled selected>
                            Ir a...
                        </option>
                        {sections.map((section: any) => (
                            <option
                                value={section.title
                                    .toLowerCase()
                                    .replace(/\s+/g, "-")
                                    .normalize("NFD")
                                    .replace(/[\u0300-\u036f]/g, "")}
                            >
                                {section.title}
                            </option>
                        ))}
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-navbar-select-icon">
                        <svg
                            class="fill-current h-4 w-4"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                        >
                            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                        </svg>
                    </div>
                </div>
            )
        }
    </div>
</nav>

<script>
    import { selectedCategory } from "../../stores/menuStore";

    // Search button focus behavior
    let searchHighlightTimeout: any = null;
    let searchScrollTimeout: any = null;
    let searchSafetyTimeout: any = null;

    const searchBtn = document.getElementById("navbar-search-btn");
    if (searchBtn) {
        searchBtn.addEventListener("click", () => {
            const searchInput = document.getElementById(
                "menu-search-input",
            ) as HTMLInputElement | null;
            if (!searchInput) return;

            // Limpiar timers previos si el usuario hace click repetido
            clearTimeout(searchHighlightTimeout);
            clearTimeout(searchScrollTimeout);
            clearTimeout(searchSafetyTimeout);

            // Calcular posición descontando la altura del Navbar fijo
            const nav = document.querySelector("nav");
            const navHeight = nav ? nav.getBoundingClientRect().height : 70;
            const inputRect = searchInput.getBoundingClientRect();
            const targetScrollY = Math.max(0, window.scrollY + inputRect.top - navHeight - 16);

            const triggerHighlightAndFocus = () => {
                try {
                    searchInput.focus({ preventScroll: true });
                } catch {
                    searchInput.focus();
                }

                // Disparar animación de resaltado visible
                searchInput.classList.remove("search-input-highlight");
                void searchInput.offsetWidth;
                searchInput.classList.add("search-input-highlight");

                setTimeout(() => {
                    searchInput.classList.remove("search-input-highlight");
                }, 1400);
            };

            // Si ya estamos prácticamente en la posición visible, animar tras un breve instante
            if (Math.abs(window.scrollY - targetScrollY) < 20) {
                searchHighlightTimeout = setTimeout(triggerHighlightAndFocus, 200);
                return;
            }

            // Mismo desplazamiento nativo que el botón "volver arriba"
            let finished = false;

            const onFinish = () => {
                if (finished) return;
                finished = true;
                window.removeEventListener("scrollend", onFinish);
                window.removeEventListener("scroll", onScroll);
                clearTimeout(searchScrollTimeout);
                clearTimeout(searchSafetyTimeout);

                // Retrasar la animación (450ms) para que ocurra con el scroll completamente detenido y a la vista
                searchHighlightTimeout = setTimeout(triggerHighlightAndFocus, 450);
            };

            const onScroll = () => {
                clearTimeout(searchScrollTimeout);
                // Si está en el destino o el scroll se detuvo
                const isNearTarget = Math.abs(window.scrollY - targetScrollY) <= 4;
                searchScrollTimeout = setTimeout(onFinish, isNearTarget ? 100 : 250);
            };

            // Evento moderno nativo scrollend (se dispara exactamente cuando termina el smooth scroll)
            window.addEventListener("scrollend", onFinish, { once: true });
            // Detector de final de scroll para navegadores que no emitan scrollend
            window.addEventListener("scroll", onScroll, { passive: true });
            // Timeout de seguridad amplio (3.5s) para páginas largas
            searchSafetyTimeout = setTimeout(onFinish, 3500);

            // Desplazamiento idéntico al botón volver arriba
            window.scrollTo({
                top: targetScrollY,
                behavior: "smooth"
            });
        });
    }

    const select = document.getElementById(
        "section-select",
    ) as HTMLSelectElement;

    if (select) {
        select.addEventListener("change", (e) => {
            const targetId = (e.target as HTMLSelectElement).value;
            const element = document.getElementById(targetId);

            if (element) {
                // Classic Mode OR Single Category View (if rendered)
                element.scrollIntoView({ behavior: "smooth" });
                // Also update store to keep sync if we are in categories mode and user somehow sees the section
                selectedCategory.set(targetId);
            } else {
                // Categories Mode (Grid View) - Element doesn't exist yet
                // Update store to trigger MenuController to show the section
                selectedCategory.set(targetId);
            }
        });

        // Optional: Listen to store changes to update select value if changed from elsewhere (e.g. clicking a card)
        selectedCategory.subscribe((slug) => {
            if (slug && select) {
                select.value = slug;
            } else if (!slug && select) {
                select.value = ""; // Reset to default
            }
        });
    }
</script>

<style>
    /* Style for select dropdown options */
    .navbar-select option {
        background-color: var(--color-navbar-select-option-bg);
        color: var(--color-navbar-select-option-text);
    }

    .navbar-select option:hover,
    .navbar-select option:checked {
        background-color: var(--color-navbar-select-option-hover-bg);
        color: var(--color-navbar-select-option-hover-text);
    }
</style>
