---
import { getImageUrl } from "../../lib/imageUrl";

interface Props {
    seasonalSpecials: any;
    currencySymbol: string;
    priceDivider: string;
}

const { seasonalSpecials, currencySymbol, priceDivider } = Astro.props;

// Check if seasonalSpecials exists and has items
if (
    !seasonalSpecials ||
    !seasonalSpecials.items ||
    seasonalSpecials.items.length === 0
) {
    return null;
}

// Get the first item from seasonal specials
const item = seasonalSpecials.items[0];

const imageUrl = getImageUrl(item.imgSrc, 800);
---

<section class="w-full bg-seasonal-bg px-4 md:px-6 lg:px-8 pt-8 pb-2">
    <div
        class="bg-seasonal-card-bg rounded-2xl shadow-xl overflow-hidden md:flex md:flex-row-reverse"
    >
        <div class="md:w-1/2 h-64 md:h-auto relative">
            <img
                src={imageUrl}
                alt={item.alt || item.name}
                class="w-full h-full object-cover"
                loading="eager"
                decoding="async"
                fetchpriority="high"
            />
        </div>
        <div class="p-6 md:p-10 md:w-1/2 flex flex-col justify-center">
            <span
                class="inline-block px-3 py-1 mb-4 text-xs font-bold tracking-wider uppercase bg-white/20 text-white rounded-full w-fit"
            >
                {seasonalSpecials.title || "ESPECIAL DE TEMPORADA"}
            </span>
            <h2
                class="text-3xl md:text-4xl font-bold mb-4 text-seasonal-text-name"
            >
                {item.name}
            </h2>
            <span
                class="inline-block px-3 py-1 mb-4 text-xs tracking-wider uppercase bg-white/20 text-white rounded-full w-fit"
            >
                {item.subtitle}
            </span>
            <p class="text-md mb-6 text-seasonal-subtitle opacity-90">
                {item.description}
            </p>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold text-seasonal-text-price"
                    >{currencySymbol}{item.price}</span
                >
                {
                    item.price2 && (
                        <span class="text-xl text-seasonal-text-price opacity-80">
                            {" "}
                            {priceDivider} {currencySymbol}
                            {item.price2}
                        </span>
                    )
                }
            </div>
            {
                item.availability && (
                    <p class="mt-4 text-sm text-seasonal-subtitle font-semibold italic">
                        {item.availability}
                    </p>
                )
            }
        </div>
    </div>
</section>
