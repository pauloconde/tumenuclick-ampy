---
interface Props {
    item: {
        name: string;
        slug?: string;
        price: string;
        price2?: string;
        price3?: string;
        description: string;
        imgSrc: string;
        alt: string;
        availability?: string;
        bestSeller?: boolean;
        isNew?: boolean;
        servings?: number;
        protein?: number;
        gallery?: string[];
        variantGroups?: any[];
    };
    section?: string;
    currencySymbol: string;
    priceDivider: string;
    newsTitleSingular?: string;
}

import { getImageUrl } from "../../../lib/imageUrl";
import { getServingsIconHtml } from "../icons/ServingsIcon";

const { item, section, currencySymbol, priceDivider, newsTitleSingular } = Astro.props;

// Obtener URL de imagen (Sanity o local)
const imageUrl = getImageUrl(item.imgSrc, 300);

// Generar HTML del icono de porciones
const servingsIconHtml = getServingsIconHtml(item.servings || 0);

// Prepare variant images map
const variantImages: Record<string, string> = {};
if (item.variantGroups) {
    item.variantGroups.forEach((group: any) => {
        if (group.variants) {
            group.variants.forEach((variant: any) => {
                const img = getImageUrl(variant.image, 800);
                if (img) {
                    variantImages[variant.name] = img;
                }
            });
        }
    });
}

const galleryUrls = item.gallery ? item.gallery.map((img: string) => getImageUrl(img, 800)) : [];
---

<div class="flex-shrink-0 w-60">
    <div 
        class="bg-seasonal-card-bg rounded-lg shadow-md p-3 flex flex-col h-[340px] cursor-pointer product-detail-trigger transition-transform hover:scale-[1.02]"
        data-name={item.name}
        data-slug={item.slug}
        data-price={item.price}
        data-price2={item.price2}
        data-price3={item.price3}
        data-description={item.description}
        data-image={imageUrl}
        data-currency={currencySymbol}
        data-best-seller={item.bestSeller ? "true" : "false"}
        data-best-seller-label="Favorito"
        data-is-new={item.isNew ? "true" : "false"}
        data-new-label={newsTitleSingular || "Nuevo"}
        data-section={section}
        data-section={section}
        data-servings={String(item.servings || 0)}
        data-protein={String(item.protein || 0)}
        data-gallery={JSON.stringify(galleryUrls)}
        data-variant-images={JSON.stringify(variantImages)}
    >
        <!-- Image first for better visual hierarchy -->
        <img
            alt={item.alt || item.name}
            class="w-full h-40 object-cover rounded-md mb-3"
            src={imageUrl}
            loading="lazy"
            decoding="async"
        />
        
        <!-- Title and Price -->
        <div class="flex items-start justify-between gap-2 mb-2">
            <h3 class="font-bold text-seasonal-text-name text-base line-clamp-2 min-h-[2.5rem] flex-1 flex items-center gap-1">
                {item.name}
                {servingsIconHtml && <Fragment set:html={servingsIconHtml} />}
            </h3>
            <p class="text-seasonal-text-price font-bold text-sm whitespace-nowrap flex-shrink-0">
                {currencySymbol}{item.price}
                {
                    item.price2 && (
                        <span class="ml-1">
                            {priceDivider} 
                        </span>
                        <span class="ml-1">
                            {currencySymbol}{item.price2}
                        </span>
                    )
                }
                {
                    item.price3 && (
                         <span class="ml-1">
                            {priceDivider} 
                        </span>
                        <span class="ml-1">
                            {currencySymbol}{item.price3}
                        </span>
                    )
                }
            </p>
        </div>
        
        <!-- Description - limited to 3 lines -->
        <p class="text-seasonal-subtitle text-xs leading-relaxed line-clamp-3">
            {item.description}
        </p>
        
        <!-- Availability at bottom if exists -->
        {item.availability && (
            <p class="text-xs text-seasonal-subtitle font-semibold italic mt-auto pt-2">
                {item.availability}
            </p>
        )}
    </div>
</div>
